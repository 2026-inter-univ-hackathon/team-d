rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidEventFields(data) {
      return data.keys().hasAll([
          'title', 'memo', 'status', 'date', 'time', 'duration',
          'remindedOn', 'version', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'memo', 'status', 'date', 'time', 'duration',
          'remindedOn', 'version', 'createdAt', 'legacyId'
        ])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.memo is string
        && data.memo.size() <= 10000
        && data.status is string
        && data.status in ['TENTATIVE', 'CONFIRMED', 'COMPLETED']
        && (data.date == null || data.date is string)
        && (data.time == null || data.time is string)
        && data.duration is int
        && data.duration >= 1
        && data.duration <= 24
        && (data.remindedOn == null || data.remindedOn is string)
        && data.version is int
        && data.createdAt is timestamp
        && (!('legacyId' in data)
          || (data.legacyId is string
            && data.legacyId.size() >= 1
            && data.legacyId.size() <= 100));
    }

    match /users/{userId}/events/{eventId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasValidEventFields(request.resource.data)
        && request.resource.data.version == 1;

      allow update: if isOwner(userId)
        && hasValidEventFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if isOwner(userId);
    }
  }
}
